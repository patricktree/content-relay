{
  "$schema": "./node_modules/turbo/schema.json",
  "noUpdateNotifier": true,
  "concurrency": "100%",
  "tasks": {
    "turbo:build": {
      "cache": false,
    },
    "turbo:dev": {
      "cache": false,
      "persistent": true,
    },
    "turbo:lint": {
      "cache": false,
    },
    "turbo:lint:fix": {
      "cache": false,
    },
    "turbo:test": {
      "cache": false,
    },
  },
}
