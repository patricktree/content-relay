{
  "$schema": "./node_modules/turbo/schema.json",
  "noUpdateNotifier": true,
  "tasks": {
    "turbo:build": {
      "cache": true,
      "dependsOn": ["^turbo:build"],
      "outputs": [
        /* TypeScript */
        "dist/**",
        "*.tsbuildinfo",
        /* Swift */
        ".build/**",
      ],
    },
    "turbo:dev": {
      "cache": false,
      "persistent": true,
    },
    "turbo:lint": {
      "cache": true,
      "dependsOn": ["^turbo:build"],
      "outputs": [],
    },
    "turbo:lint:fix": {
      "cache": true,
      "dependsOn": ["^turbo:build"],
      "outputs": [
        /* TypeScript */
        "src/**",
      ],
    },
    "turbo:test": {
      "cache": true,
      "dependsOn": ["turbo:build"],
    },
  },
}
