{
  "$schema": "./node_modules/turbo/schema.json",
  "tasks": {
    "clean": {
      "cache": false,
    },
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["*.tsbuildinfo"],
    },
    "dev": {
      "cache": false,
      "persistent": true,
    },
    "lint": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["src/**"],
    },
  },
}
