{
  "$schema": "./node_modules/turbo/schema.json",
  "tasks": {
    "clean": {
      "cache": false,
    },
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": [
        /* TypeScript */
        "dist/**",
        "*.tsbuildinfo",
        /* Switft */
        ".build/**",
      ],
    },
    "dev": {
      "cache": false,
      "persistent": true,
    },
    "lint": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": [],
    },
    "lint:fix": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": [
        /* TypeScript */
        "src/**",
      ],
    },
    "test": {
      "cache": true,
      "dependsOn": ["build"],
    },
  },
}
