{
  "name": "@content-relay/pkg-management",
  "private": true,
  "type": "module",
  "imports": {
    "#pkg/*.ts": {
      "types": "./dist/types/*.d.ts",
      "default": "./src/*.ts"
    },
    "#pkg/*": {
      "types": "./dist/types/*",
      "default": "./src/*"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsgo --build ./tsconfig.json",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\"",
    "dev": "tsgo --build ./tsconfig.json --watch",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "pnpm run lint --fix"
  },
  "dependencies": {
    "@pnpm/filter-workspace-packages": "^1000.1.6",
    "@pnpm/find-workspace-dir": "^1000.1.5",
    "@pnpm/logger": "^1001",
    "@pnpm/worker": "^1000",
    "@pnpm/workspace.find-packages": "^1000.0.65",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@content-relay/config-eslint": "workspace:*",
    "@content-relay/config-typescript": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "^24"
  }
}
