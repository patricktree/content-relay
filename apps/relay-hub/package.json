{
  "name": "@content-relay/relay-hub",
  "private": true,
  "bin": {
    "relay-hub": "./src/bin.ts"
  },
  "files": [
    "src/**"
  ],
  "type": "module",
  "imports": {
    "#pkg/*.ts": {
      "types": "./dist/types/*.d.ts",
      "default": "./src/*.ts"
    },
    "#pkg/*": {
      "types": "./dist/types/*",
      "default": "./src/*"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsgo --build ./tsconfig.json",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\"",
    "dev": "tsgo --build ./tsconfig.json --watch",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "pnpm run lint --fix"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "@content-relay/o11y.logs": "workspace:*",
    "@content-relay/o11y.node-sdk": "workspace:*",
    "@content-relay/shared": "workspace:*",
    "@hono/node-server": "^2.0.0",
    "@hono/zod-openapi": "^1.3.0",
    "@hono/zod-validator": "^0.7.6",
    "@patricktree/commons-ecma": "^3.1.1",
    "@patricktree/commons-node": "^3.1.1",
    "better-sqlite3": "^12.9.0",
    "commander": "^14.0.3",
    "dioma": "^0.4.6",
    "drizzle-orm": "^0.45.2",
    "hono": "catalog:",
    "temporal-polyfill": "^0.3.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@content-relay/config-eslint": "workspace:*",
    "@content-relay/config-typescript": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "^24"
  }
}
