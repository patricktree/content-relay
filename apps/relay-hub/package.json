{
  "name": "@content-relay/relay-hub",
  "private": true,
  "files": [
    "src/**"
  ],
  "type": "module",
  "imports": {
    "#src/*.ts": {
      "types": "./dist/types/*.d.ts",
      "default": "./src/*.ts"
    },
    "#src/*": {
      "types": "./dist/types/*",
      "default": "./src/*"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\"",
    "dev": "turbo run turbo:dev",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "start": "node ./src/bin.ts",
    "turbo:build": "tsgo --build ./tsconfig.json",
    "turbo:dev": "tsgo --build ./tsconfig.json --watch",
    "turbo:lint": "oxlint --type-aware --max-warnings 0 .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "@content-relay/contracts": "workspace:*",
    "@hono/node-server": "^2.0.8",
    "@hono/zod-openapi": "^1.4.0",
    "@patricktree-stack/o11y.logs": "workspace:*",
    "@patricktree-stack/o11y.node-sdk": "workspace:*",
    "@patricktree-stack/utils-node": "workspace:*",
    "@patricktree/commons-ecma": "^3.1.1",
    "@patricktree/commons-node": "^3.1.1",
    "better-sqlite3": "^12.11.1",
    "commander": "^15.0.0",
    "dioma": "^0.4.6",
    "drizzle-orm": "^0.45.2",
    "hono": "catalog:",
    "temporal-polyfill": "^1.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@patricktree-stack/config-oxlint": "workspace:*",
    "@patricktree-stack/config-typescript": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  }
}
