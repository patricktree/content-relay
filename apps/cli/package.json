{
  "name": "@content-relay/cli",
  "private": true,
  "bin": {
    "relay": "./src/cli.ts"
  },
  "type": "module",
  "imports": {
    "#pkg/*.ts": {
      "types": "./dist/types/*.d.ts",
      "default": "./src/*.ts"
    },
    "#pkg/*": {
      "types": "./dist/types/*",
      "default": "./src/*"
    }
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\"",
    "dev": "turbo run turbo:dev",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "test": "turbo run turbo:test",
    "turbo:build": "tsgo --build ./tsconfig.json",
    "turbo:dev": "tsgo --build ./tsconfig.json --watch",
    "turbo:lint": "oxlint --type-aware --max-warnings 0 .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix",
    "turbo:test": "vitest run"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "@content-relay/client": "workspace:*",
    "@content-relay/contracts": "workspace:*",
    "@content-relay/o11y.node-sdk": "workspace:*",
    "@content-relay/utils-ecma": "workspace:*",
    "@patricktree/commons-ecma": "^3.1.1",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@content-relay/config-oxlint": "workspace:*",
    "@content-relay/config-typescript": "workspace:*",
    "@content-relay/relay-hub-test-utils": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "^4.3.6"
  }
}
