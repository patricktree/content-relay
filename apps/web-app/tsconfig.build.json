{
  "extends": [
    "@content-relay/config-typescript/tsconfig.defaults.json",
    "@content-relay/config-typescript/tsconfig.web.json",
    "@content-relay/config-typescript/tsconfig.composite-emit-declaration-only.json"
  ],
  "compilerOptions": {
    /* Modules */
    "rootDir": "./src",
    "types": ["vite/client"],

    /* Language and Environment */
    "jsx": "react-jsx"
  },
  "include": ["src/**/*"],
  "exclude": ["**/node_modules", "**/*.test.ts"]
}
