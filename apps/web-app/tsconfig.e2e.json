{
  "extends": [
    "@patricktree-stack/config-typescript/tsconfig.defaults.json",
    "@patricktree-stack/config-typescript/tsconfig.typescript-execution-via-type-stripping.json",
    "@patricktree-stack/config-typescript/tsconfig.playwright.json"
  ],
  "compilerOptions": {
    /* Modules */
    "rootDir": ".",
    "types": ["node"],

    /* Emit */
    "noEmit": true,

    /* Language and Environment */
    "jsx": "react-jsx"
  },
  "include": ["playwright.config.ts", "test-e2e/**/*"],
  "references": [{ "path": "./tsconfig.build.json" }]
}
