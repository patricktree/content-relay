{
  "name": "@content-relay/web-app",
  "private": true,
  "type": "module",
  "imports": {
    "#test-e2e/*.ts": "./test-e2e/*.ts",
    "#src/*.ts": {
      "types": "./dist/types/*.d.ts",
      "default": "./src/*.ts"
    },
    "#src/*.tsx": {
      "types": "./dist/types/*.d.tsx",
      "default": "./src/*.tsx"
    },
    "#src/*": {
      "types": "./dist/types/*",
      "default": "./src/*"
    }
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\"",
    "dev": "vite",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "test": "turbo run turbo:test",
    "test:coverage": "vitest run --coverage --dir test",
    "test:e2e": "docker pull mcr.microsoft.com/playwright:v1.64.0-noble && pnpm exec playwright test",
    "test:e2e:ui": "pnpm run test:e2e --ui",
    "test:e2e:update": "pnpm run test:e2e --update-snapshots",
    "turbo:build": "tsc --build ./tsconfig.json && vite build",
    "turbo:lint": "oxlint --type-aware --max-warnings 0 .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix",
    "turbo:test": "vitest run --dir test && pnpm run test:e2e"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@content-relay/client": "workspace:*",
    "@content-relay/contracts": "workspace:*",
    "@fontsource/rubik": "^5.3.0",
    "@linaria/react": "^8.2.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.1",
    "@tauri-apps/plugin-opener": "^2.7.1",
    "material-symbols": "^0.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "temporal-polyfill": "^1.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@content-relay/relay-hub-test-utils": "workspace:*",
    "@content-relay/seeding-tool": "workspace:*",
    "@patricktree-stack/config-oxlint": "workspace:*",
    "@patricktree-stack/config-playwright": "workspace:*",
    "@patricktree-stack/config-typescript": "workspace:*",
    "@patricktree-stack/config-vitest": "workspace:*",
    "@patricktree-stack/config-wyw-in-js": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "catalog:",
    "@wyw-in-js/vite": "^2.5.1",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
