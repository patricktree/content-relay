{
  "name": "@content-relay/web-app",
  "private": true,
  "type": "module",
  "imports": {
    "#pkg/*.ts": {
      "types": "./dist/types/*.d.ts",
      "default": "./src/*.ts"
    },
    "#pkg/*.tsx": {
      "types": "./dist/types/*.d.tsx",
      "default": "./src/*.tsx"
    },
    "#pkg/*": {
      "types": "./dist/types/*",
      "default": "./src/*"
    }
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\"",
    "dev": "vite",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "test": "turbo run turbo:test",
    "turbo:build": "tsgo --build ./tsconfig.json && vite build",
    "turbo:dev": "vite",
    "turbo:lint": "eslint --max-warnings 0 .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix",
    "turbo:test": "vitest run"
  },
  "dependencies": {
    "@capacitor/core": "^8.3.1",
    "@content-relay/client": "workspace:*",
    "@content-relay/shared": "workspace:*",
    "@linaria/core": "^7.0.0",
    "@linaria/react": "^7.0.1",
    "@tanstack/react-query": "^5.100.7",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@content-relay/config-eslint": "workspace:*",
    "@content-relay/config-typescript": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "catalog:",
    "@vitejs/plugin-react": "^6.0.1",
    "@wyw-in-js/vite": "^1.1.0",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.0.10",
    "vitest": "catalog:"
  }
}
