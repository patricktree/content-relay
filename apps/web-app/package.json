{
  "name": "@content-relay/web-app",
  "private": true,
  "type": "module",
  "imports": {
    "#test-e2e/*.ts": "./test-e2e/*.ts",
    "#src/*.ts": {
      "types": "./dist/types/*.d.ts",
      "default": "./src/*.ts"
    },
    "#src/*.tsx": {
      "types": "./dist/types/*.d.tsx",
      "default": "./src/*.tsx"
    },
    "#src/*": {
      "types": "./dist/types/*",
      "default": "./src/*"
    }
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\"",
    "dev": "vite",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "test": "turbo run turbo:test",
    "test:e2e": "docker pull mcr.microsoft.com/playwright:v1.61.1-noble && pnpm exec playwright test",
    "test:e2e:ui": "pnpm run test:e2e --ui",
    "test:e2e:update": "pnpm run test:e2e --update-snapshots",
    "turbo:build": "tsc --build ./tsconfig.json && vite build",
    "turbo:dev": "vite",
    "turbo:lint": "oxlint --type-aware --max-warnings 0 .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix",
    "turbo:test": "pnpm run test:e2e"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@content-relay/client": "workspace:*",
    "@content-relay/contracts": "workspace:*",
    "@fontsource/rubik": "^5.2.8",
    "@linaria/react": "^8.0.0",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.101.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "material-symbols": "^0.45.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "temporal-polyfill": "^1.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@content-relay/relay-hub-test-utils": "workspace:*",
    "@content-relay/seeding-tool": "workspace:*",
    "@patricktree-stack/config-oxlint": "workspace:*",
    "@patricktree-stack/config-typescript": "workspace:*",
    "@playwright/test": "1.61.1",
    "@types/node": "catalog:",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "^6.0.3",
    "@wyw-in-js/vite": "^2.1.3",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.1.3"
  }
}
