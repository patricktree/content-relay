{
  "extends": [
    "@content-relay/config-typescript/tsconfig.defaults.json",
    "@content-relay/config-typescript/tsconfig.node-direct-ts-execution.json",
    "@content-relay/config-typescript/tsconfig.web.json",
    "@content-relay/config-typescript/tsconfig.vitest.json"
  ],
  "compilerOptions": {
    /* Modules */
    "rootDir": "./test",
    "types": ["node"],

    /* Language and Environment */
    "jsx": "react-jsx"
  },
  "include": ["test/**/*", "src/**/*.test.ts"],
  "exclude": ["test-e2e/**/*"],
  "references": [{ "path": "./tsconfig.build.json" }]
}
