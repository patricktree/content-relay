{
  "name": "@content-relay/shared",
  "private": true,
  "files": [
    "src/**"
  ],
  "type": "module",
  "imports": {
    "#pkg/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsgo --build ./tsconfig.json",
    "clean": "rm -rf tsconfig.tsbuildinfo",
    "dev": "tsgo --build ./tsconfig.json --watch",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "pnpm run lint --fix"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@content-relay/config-eslint": "workspace:*",
    "@content-relay/config-typescript": "workspace:*",
    "@typescript/native-preview": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "^24"
  }
}
