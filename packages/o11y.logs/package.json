{
  "name": "@content-relay/o11y.logs",
  "private": true,
  "files": [
    "src/**"
  ],
  "type": "module",
  "imports": {
    "#pkg/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
