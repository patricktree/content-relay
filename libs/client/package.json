{
  "name": "@content-relay/client",
  "private": true,
  "files": [
    "src/**"
  ],
  "type": "module",
  "imports": {
    "#pkg/*.ts": {
      "types": "./dist/types/*.d.ts",
      "default": "./src/*.ts"
    },
    "#pkg/*": {
      "types": "./dist/types/*",
      "default": "./src/*"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\"",
    "dev": "turbo run turbo:dev",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "test": "turbo run turbo:test",
    "turbo:build": "tsgo --build ./tsconfig.json && node ./scripts/export-openapi-json.ts && oxfmt ./dist/content-relay-hub-openapi.json",
    "turbo:dev": "tsgo --build ./tsconfig.json --watch",
    "turbo:lint": "eslint --max-warnings 0 .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix",
    "turbo:test": "vitest run"
  },
  "dependencies": {
    "@content-relay/relay-hub": "workspace:*",
    "@content-relay/shared": "workspace:*",
    "hono": "catalog:",
    "temporal-polyfill": "^0.3.2"
  },
  "devDependencies": {
    "@content-relay/config-eslint": "workspace:*",
    "@content-relay/config-typescript": "workspace:*",
    "@content-relay/profile-store-node": "workspace:*",
    "@content-relay/relay-hub-test-utils": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "runtime": {
      "name": "node",
      "version": "^24",
      "onFail": "error"
    }
  }
}
