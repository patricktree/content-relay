{
  "name": "@content-relay/client",
  "private": true,
  "files": [
    "src/**"
  ],
  "type": "module",
  "imports": {
    "#pkg/*.ts": {
      "types": "./dist/types/*.d.ts",
      "default": "./src/*.ts"
    },
    "#pkg/*": {
      "types": "./dist/types/*",
      "default": "./src/*"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsgo --build ./tsconfig.json",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\"",
    "dev": "tsgo --build ./tsconfig.json --watch",
    "test": "vitest run",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "pnpm run lint --fix"
  },
  "dependencies": {
    "@content-relay/backend": "workspace:*",
    "@content-relay/shared": "workspace:*",
    "hono": "catalog:",
    "temporal-polyfill": "^0.3.2"
  },
  "devDependencies": {
    "@content-relay/backend-test-utils": "workspace:*",
    "@content-relay/config-eslint": "workspace:*",
    "@content-relay/config-typescript": "workspace:*",
    "@content-relay/profile-store-node": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^24"
  }
}
