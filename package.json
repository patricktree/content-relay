{
  "name": "@content-relay/monorepo-root",
  "private": true,
  "files": [
    "./patches/**",
    "./.pnpmfile.cjs",
    "./pnpm-lock.yaml",
    "./pnpm-workspace.yaml",
    "./postinstall.sh"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "postinstall": "sh ./postinstall.sh",
    "test": "turbo run test",
    "fix": "pnpm run format && pnpm run lint:fix",
    "verify": "turbo run build lint test"
  },
  "devDependencies": {
    "del-cli": "^7.0.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.46.0",
    "turbo": "2.9.6"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@10.33.2"
}
